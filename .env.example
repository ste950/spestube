# Copia questo file in .env e modifica ciò che ti serve. Il file .env non va nel repository:
# può contenere la chiave API.

# La porta su cui apri SpesTube da questa macchina (http://localhost:8080).
SPESTUBE_PORT=8080

# Dove sta il database. Con Docker Compose non serve: è sempre /data/spestube.db, dentro
# il volume. Vale quando avvii il binario a mano.
# SPESTUBE_DB_PATH=data/spestube.db

# A che ora arrivano i video nuovi, una volta al giorno (HH:MM). È il valore iniziale: poi
# vale quello salvato nelle impostazioni dell'app.
SPESTUBE_RELEASE_TIME=07:00

# Chiave della YouTube Data API v3. Facoltativa: senza, l'app funziona con i soli feed RSS,
# e i canali si aggiungono dal link youtube.com/channel/UC… o dal loro id. Con la chiave si
# possono aggiungere anche dall'@handle.
SPESTUBE_YT_API_KEY=

# true attiva gli strumenti di sviluppo: il bottone "Rilascia ora" in Oggi e gli endpoint
# /api/dev/fetch e /api/dev/release. Nell'uso normale resta false.
SPESTUBE_DEV=false

# --- Solo per Docker Compose ---

# Il fuso orario in cui si legge l'orario di arrivo.
TZ=Europe/Rome

# Su quale indirizzo ascolta la porta pubblicata. SpesTube non ha un login proprio:
# 127.0.0.1 la rende raggiungibile solo da questa macchina, cioè dal reverse proxy con
# l'autenticazione. 0.0.0.0 la apre a tutta la rete locale.
SPESTUBE_BIND=127.0.0.1
